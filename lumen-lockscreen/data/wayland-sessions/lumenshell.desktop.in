# meson configure_file template: @BINDIR@ is substituted at configure time.
# Edit this .in, not the installed copy.

[Desktop Entry]
Name=LumenShell
Comment=ChromeOS-inspired Wayland desktop shell
Exec=@BINDIR@/start-lumenshell
Type=Application
DesktopNames=LumenShell
Keywords=wayland;lumen;shell;chromeos;
