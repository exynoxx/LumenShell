#!/bin/sh
# LumenShell session launcher (lumenshell.desktop Exec=). Wayfire's [autostart]
# (see ../wayfire/lumenshell.ini.d/autostart.ini) spawns the lumen-* binaries.

set -e

# --- 1. Session identity ----------------------------------------------------
export XDG_CURRENT_DESKTOP=LumenShell
export XDG_SESSION_DESKTOP=lumenshell
export XDG_SESSION_TYPE=wayland

# Pin NGL — Vulkan misbehaves on some host GPUs. Inherited by every autostarted
# GTK binary; export GSK_RENDERER beforehand to override.
export GSK_RENDERER="${GSK_RENDERER:-ngl}"

# --- 2. Optional pre-start hooks --------------------------------------------
if [ -d /etc/lumenshell/pre-start.d ]; then
    for hook in /etc/lumenshell/pre-start.d/*.sh; do
        [ -r "$hook" ] && . "$hook"
    done
fi

# --- 3. Hand env to systemd user manager ------------------------------------
# Best-effort: failures are non-fatal (works on systemd distros, no-op elsewhere).
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment \
        XDG_CURRENT_DESKTOP \
        XDG_SESSION_DESKTOP \
        XDG_SESSION_TYPE \
        WAYLAND_DISPLAY \
        DISPLAY \
        2>/dev/null || true
fi

# --- 4. Locate wayfire ------------------------------------------------------
WAYFIRE_BIN="${WAYFIRE_BIN:-$(command -v wayfire || true)}"
if [ -z "$WAYFIRE_BIN" ]; then
    echo "start-lumenshell: wayfire not found on PATH" >&2
    echo "Install wayfire (see install_dependencies.py) and retry." >&2
    exit 1
fi

# --- 5. Launch --------------------------------------------------------------
# exec so wayfire is the session leader logind tracks.
exec "$WAYFIRE_BIN" "$@"
